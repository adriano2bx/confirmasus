{
  "name": "@confirma/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@confirma/database": "workspace:*",
    "@confirma/domain": "workspace:*",
    "@confirma/queue": "workspace:*",
    "bullmq": "5.41.9",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "tsx": "4.19.3",
    "typescript": "5.9.3"
  }
}
