NODE_ENV=development
APP_TIMEZONE=America/Sao_Paulo
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
DATABASE_URL=postgresql://confirma:confirma@localhost:5432/confirma_sus?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# O administrador é provisionado automaticamente quando a API inicia.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
UPLOAD_TEMP_DIR=/tmp/confirma-sus
# Fallback opcional para registros com baixa confiança. Desligado por padrão.
SISREG_AI_FALLBACK_ENABLED=false
SISREG_AI_ENDPOINT=
SISREG_AI_API_KEY=
SISREG_AI_MODEL=gpt-4o-mini
MESSAGING_MODE=DRY_RUN
SCHEDULER_INTERVAL_MS=10000
MESSAGE_WORKER_CONCURRENCY=5
FINAL_RESPONSE_WINDOW_DAYS=1
WEBHOOK_WORKER_CONCURRENCY=10
MESSAGE_RATE_LIMIT_MAX=20
MESSAGE_RATE_LIMIT_DURATION_MS=1000
TEMP_FILE_MAX_AGE_HOURS=24
# Credenciais da WhatsApp Cloud API. Nunca commite tokens ou app secrets reais.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v22.0
META_WHATSAPP_LANGUAGE=pt_BR
META_TEMPLATE_FIRST_NAME=primeira_convocacao_sus_unico
META_TEMPLATE_SECOND_NAME=segunda_convocacao_sus
META_TEMPLATE_THIRD_NAME=terceira_convocacao_sus
# Respostas de sessão enviadas imediatamente após o clique do paciente.
AUTOMATIC_REPLY_ENABLED=true
AUTOMATIC_REPLY_CONFIRM_TEXT=Recebemos sua confirmação. Aguarde, em breve nossa equipe dará continuidade ao atendimento.
AUTOMATIC_REPLY_CANCEL_TEXT=Seu cancelamento foi registrado. Não enviaremos novas convocações referentes a esta solicitação.
# Transbordo automático para View/EasySAC após CONFIRM. Nunca use valores reais neste arquivo.
HANDOFF_MODE=DISABLED
HANDOFF_WORKER_CONCURRENCY=3
HANDOFF_MAX_ATTEMPTS=5
VIEW_EASYSAC_WEBHOOK=
VIEW_EASYSAC_ORG_ID=
VIEW_EASYSAC_APP_KEY=
VIEW_EASYSAC_CHANNEL_ID=
VIEW_EASYSAC_QUEUE_ID=
VIEW_EASYSAC_CHANNEL_TYPE=whatsapp
# --- Atendimento humano (inbox). Ver docs/planning/whatsapp-human-inbox-contract.md ---
# Lista separada por vírgula de phone_number_id aceitos no webhook (vazio = todos).
META_ACCEPTED_PHONE_NUMBER_IDS=
WEBHOOK_MAX_ATTEMPTS=12
HUMAN_MESSAGE_WORKER_CONCURRENCY=5
MESSAGE_RATE_LIMIT_MAX_WAIT_MS=5000
INBOX_SSE_POLL_MS=1000
# Mídia recebida: diretório privado fora do webroot (obrigatório em LIVE).
MEDIA_STORAGE_DIR=/var/lib/confirma-sus/media
MEDIA_MAX_BYTES=16777216
MEDIA_RETENTION_DAYS=30
# disabled | command. Sem scanner configurado a mídia fica em quarentena.
MEDIA_SCAN_MODE=command
MEDIA_SCAN_COMMAND=
# Token opcional para /api/ops/metrics (vazio = somente ADMIN autenticado).
OPS_METRICS_TOKEN=
OUTBOX_DISPATCH_INTERVAL_MS=2000
MEDIA_WORKER_CONCURRENCY=2
MEDIA_ALLOWED_MIME=
MEDIA_DOWNLOAD_TIMEOUT_MS=30000
MEDIA_SCAN_TIMEOUT_MS=60000
MEDIA_MAX_ATTEMPTS=5
# Fração do limite por número reservada a envios humanos (0 = sem reserva).
MESSAGE_RATE_LIMIT_HUMAN_RESERVE=0
WEBHOOK_CONTEXT_WAIT_ATTEMPTS=4
